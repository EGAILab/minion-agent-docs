{
 "about": "L0506-D005 (minion-agent#129) isolation cases. Run by pi_oracle.mjs through pinned Pi; turned into conformance/agent/arg-isolation/*.json by gen_canonical.py. Value grammar: {o:[[key,v]...]} object (insertion order), {a:[...]} array, {n:token} number (Number::toString, -0, NaN, Infinity, -Infinity), {u:[utf16 units]} string, true/false/null. Paths: object keys are strings, array indices are integers.",
 "cases": [
  {"id": "hook-sets-into-nested-object", "text": "{\"o\":{\"z\":1}}",
   "hooks": [[{"op": "set", "path": ["o"], "key": "y", "value": {"n": "2"}}]],
   "facts": [{"distinct_from_raw": ["o"]}]},
  {"id": "hook-pushes-object-into-nested-array", "text": "{\"a\":[]}",
   "hooks": [[{"op": "push", "path": ["a"], "value": {"o": [["b", {"n": "2"}], ["1", {"n": "1"}]]}}]],
   "facts": [{"distinct_from_raw": ["a"]}]},
  {"id": "hook-nested-existing-gains-index", "text": "{\"o\":{\"z\":1,\"y\":2}}",
   "hooks": [[{"op": "set", "path": ["o"], "key": "0", "value": {"n": "0"}}]]},
  {"id": "hook-replaces-and-deletes-nested", "text": "{\"o\":{\"k\":1,\"d\":2},\"l\":[1,[2]]}",
   "hooks": [[{"op": "set", "path": ["o"], "key": "k", "value": {"n": "9"}},
              {"op": "delete", "path": ["o"], "key": "d"},
              {"op": "push", "path": ["l", 1], "value": {"n": "3"}}]],
   "facts": [{"distinct_from_raw": ["l", 1]}]},
  {"id": "hook-sets-top-level", "text": "{\"t\":1}",
   "hooks": [[{"op": "set", "path": [], "key": "t", "value": {"n": "2"}}]],
   "facts": [{"distinct_from_raw": []}]},
  {"id": "two-hooks-share-the-validated-graph", "text": "{\"o\":{\"z\":1}}",
   "hooks": [[{"op": "set", "path": ["o"], "key": "y", "value": {"n": "2"}}],
             [{"op": "set", "path": ["o"], "key": "x", "value": {"n": "3"}}]]},
  {"id": "hook-reorders-nested-by-index-key", "text": "{\"o\":{\"b\":1,\"2\":2,\"a\":3}}",
   "hooks": [[{"op": "set", "path": ["o"], "key": "1", "value": {"n": "1"}}]]},
  {"id": "nested-runtime-values-survive-the-clone", "text": "{\"o\":{\"z\":-0,\"s\":\"\\ud800x\",\"t\":\"\\udc00\",\"big\":1e300}}",
   "hooks": [[{"op": "set", "path": ["o"], "key": "y", "value": {"n": "1"}}]]},
  {"id": "prepared-alias-stays-shared-in-clone", "text": "{}", "prepare": "alias",
   "hooks": [[{"op": "set", "path": ["p"], "key": "k", "value": {"n": "2"}}]],
   "facts": [{"same": [["p"], ["q"]]}]},
  {"id": "prepared-cycle-survives-clone", "text": "{}", "prepare": "cycle",
   "hooks": [[]],
   "facts": [{"same": [["self"], []]}]},
  {"id": "prepared-non-finite-values-survive-clone", "text": "{\"z\":-0,\"s\":\"\\ud800x\",\"t\":\"\\udc00\"}", "prepare": "non-finite",
   "hooks": [[]]},
  {"id": "prepared-reused-raw-child-is-isolated", "text": "{\"o\":{\"z\":1},\"t\":1}", "prepare": "reuse-raw-child",
   "hooks": [[{"op": "set", "path": ["o"], "key": "y", "value": {"n": "2"}}]],
   "facts": [{"distinct_from_raw": ["o"]}]},
  {"id": "validation-failure", "text": "{\"o\":{\"z\":1}}", "schema": {"type": "object", "required": ["missing"], "properties": {}},
   "hooks": [[{"op": "set", "path": ["o"], "key": "y", "value": {"n": "2"}}]]},
  {"id": "blocked-after-nested-mutation", "text": "{\"o\":{\"z\":1}}", "block": true,
   "hooks": [[{"op": "set", "path": ["o"], "key": "y", "value": {"n": "2"}}]]}
 ]
